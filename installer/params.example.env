# Rigel installer — пример файла параметров.
#
# Использование:
#   sudo installer/engine/rigel-engine.sh --config installer/params.example.env --dry-run
#   sudo installer/engine/rigel-engine.sh --config /run/rigel/params.env --yes
#
# TUI-установщик создаёт такой файл сам.

# ---- язык и зеркала -------------------------------------------------------
RIGEL_LANG=ru_RU.UTF-8              # локаль системы
RIGEL_KEYMAP=ru                      # раскладка клавиатуры
RIGEL_TIMEZONE=Europe/Moscow         # часовой пояс
RIGEL_MIRROR_COUNTRY=Russia          # страна для зеркал pacman

# ---- диск ----------------------------------------------------------------
RIGEL_DISK=/dev/nvme0n1             # диск целиком, не раздел
RIGEL_PART_MODE=auto                # auto | manual

# ---- пользователь ---------------------------------------------------------
RIGEL_USERNAME=user
RIGEL_ROOT_PASSWORD=changeme
RIGEL_USER_PASSWORD=changeme