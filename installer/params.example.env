# Rigel installer — пример файла параметров.
#
# Использование:
#   sudo installer/engine/rigel-engine.sh --config installer/params.example.env --dry-run
#   sudo installer/engine/rigel-engine.sh --config /run/rigel/params.env --yes
#
# TUI-установщик создаёт такой файл сам. Здесь — те же параметры вручную,
# чтобы можно было проверить логику, не запуская интерфейс.

# ---- диск и разметка -------------------------------------------------------
RIGEL_DISK=/dev/nvme0n1            # диск целиком, не раздел
RIGEL_PART_MODE=auto               # auto | manual (ручная разметка в cfdisk)
RIGEL_ROOT_FS=btrfs                # btrfs | ext4
RIGEL_HOME_MODE=separate           # separate — отдельный /home, none — в корне
RIGEL_HOME_FS=ext4                 # ext4 | btrfs
RIGEL_ESP_MIB=1024                 # ESP 1 ГиБ → ядра и initramfs лежат на ESP
RIGEL_ROOT_SIZE=45G                # пусто = авто (45 ГиБ или 60% диска)
RIGEL_SWAP=file:4G                 # none | file:4G
RIGEL_FORCE_WIPE=0                 # 1 = стирать даже если найдена Windows (NTFS)

# ---- ядро, драйверы, загрузчик --------------------------------------------
RIGEL_KERNELS="linux linux-lts"    # любые: linux, linux-lts, linux-zen, linux-hardened
RIGEL_UCODE=auto                   # auto | intel | amd | none
RIGEL_GPU=auto                     # auto | nvidia-open | nvidia | mesa
RIGEL_BOOTLOADER=auto              # auto | systemd-boot | grub

# ---- система ---------------------------------------------------------------
RIGEL_DESKTOP=hyprland             # hyprland | plasma | both | minimal | none
                                   #   hyprland — лёгкий, ставится прямо с флешки (офлайн)
                                   #   plasma   — KDE Plasma, требует интернет (plasma-meta не влезает в ISO)
                                   #   both     — Plasma по умолчанию + Hyprland в меню сеансов
RIGEL_USE_METAPACKAGES=auto        # auto | 1 — ставить rigel-meta из своего репозитория
RIGEL_USERNAME=user
RIGEL_ROOT_PASSWORD=changeme
RIGEL_USER_PASSWORD=changeme
RIGEL_HOSTNAME=rigel-pc
RIGEL_TIMEZONE=Europe/Moscow
RIGEL_LANG=ru_RU.UTF-8
RIGEL_KEYMAP=ru
RIGEL_AUTOLOGIN=0                  # 1 = автоматический вход (Hyprland на tty1 или Plasma через SDDM)

# ---- приложения: id категорий из installer/apps.d ---------------------------
# Вкладка «Базовые»: base office chat media peripherals games
# Вкладка «Про»:     kernel drivers dev server manual-boot
RIGEL_APPS_BASE="office peripherals"
RIGEL_APPS_PRO="drivers"

# ---- сеть ------------------------------------------------------------------
RIGEL_ONLINE=auto                  # auto | 1 | 0 (0 = только офлайн-набор с ISO)

# ---- служебное -------------------------------------------------------------
RIGEL_MOUNT=/mnt
RIGEL_TARGET_LABEL=rigel
RIGEL_LOG=/var/log/rigel-install.log
