#!/usr/bin/env bash
# Rigel 1 «Orion» — TUI-установщик.
#
#   sudo rigel-install            графический TUI (whiptail/dialog)
#   sudo rigel-install --text     текстовый режим (без whiptail — для отладки)
#
# Вопросы: язык → страна (зеркала) → пользователь → диск → пароль.
# После — запускается движок (engine/rigel-engine.sh).

set -uo pipefail

INSTALLER_DIR="${INSTALLER_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
PARAMS_FILE="${PARAMS_FILE:-/run/rigel/params.env}"
RIGEL_LOG="${RIGEL_LOG:-/var/log/rigel-install.log}"

# shellcheck source=lib/common.sh
. "$INSTALLER_DIR/lib/common.sh"
# shellcheck source=lib/hwdetect.sh
. "$INSTALLER_DIR/lib/hwdetect.sh"

USE_TUI=1
[ "${1:-}" = "--text" ] && USE_TUI=0
if [ "$USE_TUI" = "1" ] && ! have whiptail; then
    warn "whiptail не найден — переключаюсь в текстовый режим"
    USE_TUI=0
fi

# ------------------------------------------------------------------ ввод/вывод
ui_msg() {
    local t="$1" m="$2"
    if [ "$USE_TUI" = "1" ]; then whiptail --title "$t" --msgbox "$m" 10 70
    else printf '\n=== %s ===\n%s\n' "$t" "$m"; read -rp "Enter — дальше..." _; fi
}

ui_input() {
    local t="$1" m="$2" d="${3:-}" v
    if [ "$USE_TUI" = "1" ]; then v="$(whiptail --title "$t" --inputbox "$m" 10 70 "$d" 3>&1 1>&2 2>&3)"
    else read -rp "$m [$d]: " v; v="${v:-$d}"; fi
    printf '%s' "$v"
}

ui_password() {
    local t="$1" m="$2" v
    if [ "$USE_TUI" = "1" ]; then v="$(whiptail --title "$t" --passwordbox "$m" 10 70 3>&1 1>&2 2>&3)"
    else read -rsp "$m " v; echo >&2; fi
    printf '%s' "$v"
}

ui_menu() {
    local t="$1" m="$2"; shift 2
    local v=""
    if [ "$USE_TUI" = "1" ]; then
        v="$(whiptail --title "$t" --menu "$m" 18 70 12 "$@" 3>&1 1>&2 2>&3)"
    else
        printf '\n=== %s ===\n%s\n' "$t" "$m"
        local i=1; local -a tags=()
        while [ $# -gt 0 ]; do printf '  %d) %s\n' "$i" "$1"; tags+=("$1"); i=$((i+1)); shift; done
        read -rp "номер: " n; v="${tags[$((n-1))]:-}"
    fi
    printf '%s' "$v"
}

ui_yesno() {
    local t="$1" m="$2"
    if [ "$USE_TUI" = "1" ]; then whiptail --title "$t" --yesno "$m" 12 70
    else printf '\n=== %s ===\n%s\n' "$t" "$m"; read -rp "[y/N] " a; [[ "$a" =~ ^[YyДд] ]]; fi
}

# ------------------------------------------------------------------ языки
# Возвращает тройку: LANG|KEYMAP|TIMEZONE
lang_info() {
    case "$1" in
        Русский) printf 'ru_RU.UTF-8|ru|Europe/Moscow' ;;
        English) printf 'en_US.UTF-8|us|America/New_York' ;;
        *)       printf 'en_US.UTF-8|us|America/New_York' ;;
    esac
}

# ------------------------------------------------------------------ страны для зеркал
COUNTRIES=(
    "Russia"
    "United States"
    "Germany"
    "Netherlands"
    "France"
    "Japan"
    "Canada"
    "United Kingdom"
    "Italy"
    "Poland"
    "Sweden"
    "Australia"
    "Brazil"
    "China"
    "India"
)

# ------------------------------------------------------------------ диски
list_disks() {
    local live_src="" live_disk=""
    if [ -e /run/archiso/bootmnt ]; then
        live_src="$(findmnt -rno SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
        [ -n "$live_src" ] && live_disk="$(lsblk -rno PKNAME "$live_src" 2>/dev/null | head -n1)"
    fi
    local name size model
    while read -r name size model; do
        [ -n "$name" ] || continue
        [ "$name" = "$live_disk" ] && continue
        printf '%s|%s %s\n' "/dev/$name" "$size" "$model"
    done < <(lsblk -dpno NAME,SIZE,MODEL 2>/dev/null | grep -v '^loop')
}

# ------------------------------------------------------------------ сценарий
main_flow() {
    # --- 1 — язык ---
    local lang_choice
    lang_choice="$(ui_menu "Язык / Language" "Выберите язык системы:" \
        "Русский"  "Русский язык, раскладка ru, Москва" \
        "English"  "English language, US layout, New York")"
    [ -n "$lang_choice" ] || die "язык не выбран"

    IFS='|' read -r RIGEL_LANG RIGEL_KEYMAP RIGEL_TIMEZONE <<<"$(lang_info "$lang_choice")"

    # --- 2 — страна для зеркал ---
    local country
    country="$(ui_menu "Страна / Country" "Выберите страну для зеркал pacman
(от этого зависит скорость загрузки пакетов):" "${COUNTRIES[@]}")"
    [ -n "$country" ] || die "страна не выбрана"
    RIGEL_MIRROR_COUNTRY="$country"

    # --- 3 — пользователь ---
    RIGEL_USERNAME="$(ui_input "Пользователь" "Имя пользователя:" "$RIGEL_USERNAME")"

    # --- 4 — диск ---
    local disk_items=() d size
    while IFS='|' read -r d size; do disk_items+=("$d" "$size"); done < <(list_disks)
    [ ${#disk_items[@]} -gt 0 ] || die "не найдено ни одного диска"

    local disk_menu_args=()
    for ((i=0; i<${#disk_items[@]}; i+=2)); do
        disk_menu_args+=("${disk_items[$i]}" "${disk_items[$((i+1))]}")
    done

    RIGEL_DISK="$(ui_menu "Выбор диска" "На каком диске установить Rigel?
Все данные на нём будут удалены." "${disk_menu_args[@]}")"
    [ -n "$RIGEL_DISK" ] || die "диск не выбран"

    # --- 5 — пароль ---
    local p1 p2
    p1="$(ui_password "Пароль" "Пароль пользователя $RIGEL_USERNAME:")"
    [ -n "$p1" ] || die "пароль не может быть пустым"
    p2="$(ui_password "Пароль" "Повторите пароль:")"
    [ "$p1" = "$p2" ] || die "пароли не совпадают"
    RIGEL_USER_PASSWORD="$p1"
    RIGEL_ROOT_PASSWORD="$p1"

    if online; then RIGEL_ONLINE=1; else RIGEL_ONLINE=0; fi

    # --- подтверждение ---
    if ! ui_yesno "Подтверждение" "Установка Rigel
────────────────────────
  Язык:      $lang_choice
  Страна:    $country
  Пользователь: $RIGEL_USERNAME
  Диск:      $RIGEL_DISK

Диск будет перезаписан. Начать установку?"; then
        ui_msg "Отменено" "Установка отменена."
        exit 0
    fi
}

write_params() {
    mkdir -p "$(dirname "$PARAMS_FILE")"
    umask 077
    cat >"$PARAMS_FILE" <<EOF
# Сгенерировано rigel-install $(date '+%Y-%m-%d %H:%M:%S')
RIGEL_LANG='$RIGEL_LANG'
RIGEL_KEYMAP='$RIGEL_KEYMAP'
RIGEL_TIMEZONE='$RIGEL_TIMEZONE'
RIGEL_MIRROR_COUNTRY='$RIGEL_MIRROR_COUNTRY'
RIGEL_DISK='$RIGEL_DISK'
RIGEL_USERNAME='$RIGEL_USERNAME'
RIGEL_USER_PASSWORD='$RIGEL_USER_PASSWORD'
RIGEL_ROOT_PASSWORD='$RIGEL_ROOT_PASSWORD'
RIGEL_ONLINE='$RIGEL_ONLINE'
RIGEL_HOSTNAME='rigel-pc'
RIGEL_BOOTLOADER='grub'
RIGEL_KERNELS='linux linux-lts'
RIGEL_ROOT_FS='btrfs'
RIGEL_HOME_MODE='separate'
RIGEL_HOME_FS='ext4'
RIGEL_ESP_MIB=1024
RIGEL_SWAP='file:4G'
RIGEL_UCODE='auto'
RIGEL_TRIM=1
RIGEL_PART_MODE='auto'
EOF
    chmod 600 "$PARAMS_FILE"
}

run_install() {
    local engine="$INSTALLER_DIR/engine/rigel-engine.sh"
    chmod +x "$engine" 2>/dev/null || true

    if [ "$USE_TUI" = "1" ]; then
        : >"$RIGEL_LOG"
        "$engine" --config "$PARAMS_FILE" --yes >/dev/null 2>&1 &
        local pid=$!
        whiptail --title "Установка Rigel" --tailbox "$RIGEL_LOG" 24 92 || true
        local rc=0
        wait "$pid" || rc=$?
        if [ "$rc" -eq 0 ]; then
            ui_msg "Готово" "Установка завершена.
Выньте флешку и выполните: reboot"
        else
            ui_msg "Ошибка" "Установка прервана (код $rc). Лог: $RIGEL_LOG"
        fi
        return "$rc"
    fi

    "$engine" --config "$PARAMS_FILE" --yes
}

require_root
[ "$USE_TUI" = "1" ] || warn "текстовый режим интерфейса (--text)"
main_flow
write_params
run_install
rm -f "$PARAMS_FILE"