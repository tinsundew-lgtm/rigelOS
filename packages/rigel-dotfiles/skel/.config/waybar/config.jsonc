{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "network", "clock", "tray"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-icons": {
            "default": ["🔈", "🔉", "🔊"]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "Проводное",
        "format-disconnected": "Нет сети"
    },

    "clock": {
        "format": "{:%H:%M  %d.%m.%Y}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}