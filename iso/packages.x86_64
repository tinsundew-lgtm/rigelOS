# Rigel 1 «Orion» — пакеты внутри live-ISO.
#
# ВАЖНО: по одному пакету в строке. Несколько пакетов в одной строке pacman
# воспринимает как одно длинное имя и сборка падает.
#
# Здесь только то, что нужно САМОЙ флешке (live-система + установщик).
# Пакеты целевой системы — в installer/lib/packages.sh (через pacstrap).

# --- обязательное для archiso ---
base
mkinitcpio
mkinitcpio-archiso
archlinux-keyring
linux
linux-lts
linux-firmware
intel-ucode
amd-ucode

# --- установщик Rigel: разметка, форматирование, установка ---
arch-install-scripts
gptfdisk
parted
dosfstools
e2fsprogs
btrfs-progs
exfatprogs
ntfs-3g
snapper
snap-pac
libnewt
dialog
sudo
curl
wget
reflector

# --- консольные инструменты live-режима ---
nano
vim
less
man-db
man-pages
bash-completion
fastfetch
inxi
lshw
usbutils
pciutils
dmidecode

# --- сеть, звук, bluetooth ---
networkmanager
network-manager-applet
bluez
bluez-utils
blueman
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol
alsa-utils
sof-firmware
polkit
polkit-gnome

# --- загрузчики live-ISO (нужны для сборки самого ISO) ---
syslinux
grub
efibootmgr

# --- осиное гнездо (комментируйте что не нужно) ---
