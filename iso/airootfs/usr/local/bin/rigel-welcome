#!/usr/bin/env bash
# Rigel 1 «Orion» — приветствие живой системы.
# Показывается на tty1 (см. /root/.bash_profile) и предлагает установку.

set -uo pipefail

VERSION="1 «Orion»"

c_ok=$'\033[1;32m'; c_warn=$'\033[1;33m'; c_err=$'\033[1;31m'
c_b=$'\033[1m'; c_off=$'\033[0m'

clear 2>/dev/null || true
cat <<BANNER

  ${c_b}██████╗ ██╗ ██████╗ ███████╗██╗     ${c_off}
  ${c_b}██╔══██╗██║██╔════╝ ██╔════╝██║     ${c_off}
  ${c_b}██████╔╝██║██║  ███╗█████╗  ██║     ${c_off}
  ${c_b}██╔══██╗██║██║   ██║██╔══╝  ██║     ${c_off}
  ${c_b}██║  ██║██║╚██████╔╝███████╗███████╗${c_off}
  ${c_b}╚═╝  ╚═╝╚═╝ ╚═════╝ ╚══════╝╚══════╝${c_off}

  Rigel Linux $VERSION — живая система на базе Arch Linux
  Русский язык, автоматическое определение драйверов, btrfs + снапшоты.

BANNER

# --- краткая сводка о машине ----------------------------------------------
if command -v fastfetch >/dev/null 2>&1; then
    fastfetch --logo none 2>/dev/null | head -n 12 || true
else
    printf '  ядро:   %s\n' "$(uname -r)"
    printf '  память: %s\n' "$(free -h 2>/dev/null | awk '/^Mem:/{print $2" всего, "$7" свободно"}')"
fi

printf '\n  диски, доступные для установки:\n'
if command -v lsblk >/dev/null 2>&1; then
    lsblk -dpno NAME,SIZE,MODEL 2>/dev/null | grep -v '^/dev/loop' | sed 's/^/    /' || true
fi

if ping -c1 -W2 archlinux.org >/dev/null 2>&1; then
    printf '\n  сеть: %sесть%s (онлайн-режим установки доступен)\n' "$c_ok" "$c_off"
else
    printf '\n  сеть: %sнет%s — доступна только установка из локального набора\n' "$c_warn" "$c_off"
fi

if [ ! -x /usr/local/lib/rigel-installer/rigel-install ]; then
    printf '\n  %sВНИМАНИЕ: установщик не найден (%s).%s\n' "$c_err" "/usr/local/lib/rigel-installer" "$c_off"
    printf '  ISO собран без scripts/build-iso.sh — пересоберите профиль этим скриптом.\n'
fi

cat <<'MENU'

  Что делаем?

    1) Установить Rigel на диск        (рекомендуется)
    2) Живая среда Hyprland            (посмотреть дистрибутив без установки)
    3) Терминал
    4) Проверить компьютер и диски     (inxi + lsblk)
    5) Перезагрузить
    6) Выключить

MENU

read -rp "  Ваш выбор [1]: " choice
case "${choice:-1}" in
    1)
        if [ -x /usr/local/lib/rigel-installer/rigel-install ]; then
            sudo /usr/local/bin/rigel-install
        else
            printf '\n  %sУстановщик недоступен — см. предупреждение выше.%s\n' "$c_err" "$c_off"
            read -rp "  Enter — вернуться в меню..." _
        fi
        ;;
    2)
        printf '\n  Запускаю Hyprland. Выход из сессии — Ctrl+Super+Backspace.\n'
        sleep 2
        exec Hyprland
        ;;
    3)
        printf '\n  Подсказки: rigel-install — установка, lsblk — диски, ip a — сеть.\n'
        exec bash -l
        ;;
    4)
        command -v inxi >/dev/null 2>&1 && inxi -Fzxx
        printf '\n'
        lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT,MODEL
        read -rp "  Enter — вернуться в меню..." _
        ;;
    5) systemctl reboot ;;
    6) systemctl poweroff ;;
    *) printf '  Не понял выбор, выхожу в терминал.\n'; exec bash -l ;;
esac

# Вернуться в меню, если пункт не завершился перезагрузкой/exec
exec /usr/local/bin/rigel-welcome
