# Maintainer: Rigel Linux <https://github.com/tinSundew/rigel>
#
# rigel-install-gui — графический установщик Rigel на GTK4/libadwaita.
# Заменяет TUI-версию (rigel-install + whiptail/dialog).
# Для работы требует rigel-installer (движок установки).

pkgname=rigel-install-gui
pkgver=1.0
pkgrel=1
pkgdesc='Graphical installer for Rigel Linux (GTK4/libadwaita)'
arch=('any')
url='https://github.com/tinSundew/rigel'
license=('GPL3')
depends=(
  'rigel-installer'
  'python-gobject'
  'gtk4'
  'libadwaita'
)
makedepends=()

source=(
  'rigel-install-gui'
  'src/main.py'
)

sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 rigel-install-gui "${pkgdir}/usr/bin/rigel-install-gui"
  install -Dm644 src/main.py "${pkgdir}/usr/share/rigel-install-gui/src/main.py"
}